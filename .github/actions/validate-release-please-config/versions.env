# Versions used by this action, kept current by Renovate (customManagers in the
# repo's renovate.json5, grouped with the GitHub Actions updates).
#
# RELEASE_PLEASE_VERSION must equal the release-please version bundled by the
# release-please-action pinned in .github/workflows/release-please.yml; the
# validate-release-please-config workflow checks this on every PR that moves
# either pin.

# renovate: datasource=npm depName=release-please
RELEASE_PLEASE_VERSION=17.6.0

# renovate: datasource=github-releases depName=sourcemeta/jsonschema extractVersion=^v(?<version>.+)$
JSONSCHEMA_VERSION=17.2.0
