{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Floats on the default branch by design: a shared-config fix reaches every
    // consuming repo without a migration. Do not pin.
    //
    // Resolved from the default branch even here, so edits to shared.json5 take
    // effect for this repo only once merged.
    "github>chinmina/.github//renovate/shared.json5",
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Versions pinned in validate-release-please-config/versions.env.",
      managerFilePatterns: ["/^\\.github/actions/validate-release-please-config/versions\\.env$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n[A-Z_]+=(?<currentValue>\\S+)",
      ],
    },
  ],
  // Local rules only, ordered broad -> narrow: last match wins per-option.
  packageRules: [
    {
      // RELEASE_PLEASE_VERSION must move with release-please-action's pin.
      description: "Update validate-release-please-config's pinned versions in the GitHub Actions group.",
      matchFileNames: [".github/actions/validate-release-please-config/versions.env"],
      groupName: "GitHub Actions",
    },
  ],
}
